rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    // words and daily_boards doc IDs start with the owner's uid
    match /{collection}/{docId} {
      allow read: if collection in ['words', 'daily_boards'] && request.auth != null
        && (resource == null || resource.data.user_id == request.auth.uid);
      allow write: if collection in ['words', 'daily_boards'] && request.auth != null
        && docId.matches(request.auth.uid + '_.*')
        && request.resource.data.user_id == request.auth.uid;
    }
  }
}
