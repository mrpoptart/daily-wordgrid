{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run lint && next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "validate": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project boggle-me \"vitest run tests/emulator\"",
    "emulators": "firebase emulators:start --only auth,firestore --project boggle-me",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project boggle-me",
    "migrate:export": "node scripts/export-supabase.mjs",
    "migrate:import": "node scripts/migrate-supabase-to-firebase.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.14",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "jsdom": "^27.0.1",
    "next": "15.5.9",
    "pf-sowpods": "^1.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "firebase-tools": "^15.34.0",
    "globals": "^16.5.0",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --fix"
  }
}
